{
    "name": "henshin",
    "private": true,
    "version": "2.0.28",
    "type": "module",
    "main": "electron/main.js",
    "build": {
        "appId": "com.henshin.app",
        "productName": "Henshin 変身",
        "artifactName": "Henshin-Setup-${version}.${ext}",
        "protocols": [
            {
                "name": "Henshin Application Protocol",
                "schemes": [
                    "henshin"
                ]
            }
        ],
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "extraResources": [
            {
                "from": "vendor/akvirtualcamera",
                "to": "akvirtualcamera",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "afterPack": "build/afterPack.cjs",
        "win": {
            "target": [
                "nsis"
            ],
            "executableName": "HENSHIN",
            "icon": "public/logo.png"
        },
        "nsis": {
            "oneClick": true,
            "allowElevation": true,
            "perMachine": true,
            "packElevateHelper": true,
            "include": "build/installer.nsh"
        }
    },
    "scripts": {
        "dev": "vite",
        "dev:api": "bun run scripts/local-api-server.mjs",
        "dev:web": "vite",
        "dev:all": "concurrently -n api,web -c blue,green \"bun run dev:api\" \"bun run dev:web\"",
        "build": "cross-env NODE_OPTIONS=--max-old-space-size=2048 vite build",
        "test": "bun test",
        "vercel:build": "bun run scripts/vercel-preflight.mjs && bun run build",
        "lint": "eslint .",
        "preview": "vite preview",
        "electron:dev": "node scripts/dev-electron.mjs",
        "electron:build": "bun run build && electron-builder --win",
        "electron:release": "bun run build && electron-builder --win --publish never",
        "release:sync": "bun run scripts/sync-release-version.mjs",
        "release:preflight": "bun run scripts/release-preflight.mjs"
    },
    "dependencies": {
        "@fal-ai/client": "^1.10.1",
        "@fontsource-variable/geist": "^5.3.0",
        "@hookform/resolvers": "^5.2.2",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@radix-ui/react-aspect-ratio": "^1.1.8",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-collapsible": "^1.1.12",
        "@radix-ui/react-context-menu": "^2.2.16",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-hover-card": "^1.1.15",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-menubar": "^1.1.16",
        "@radix-ui/react-navigation-menu": "^1.2.14",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slider": "^1.3.6",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-toggle": "^1.1.10",
        "@radix-ui/react-toggle-group": "^1.1.11",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@reactor-models/x2": "0.5.2",
        "@supabase/supabase-js": "^2.100.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "dotenv": "^16.3.1",
        "embla-carousel-react": "^8.6.0",
        "express": "^4.18.2",
        "false": "^0.0.4",
        "input-otp": "^1.4.2",
        "lucide-react": "^0.562.0",
        "metal-fx": "^1.0.4",
        "motion": "^13.1.1",
        "multer": "^1.4.5-lts.1",
        "next-themes": "^0.4.6",
        "react": "^19.2.0",
        "react-day-picker": "^9.13.0",
        "react-dom": "^19.2.0",
        "react-hook-form": "^7.70.0",
        "react-resizable-panels": "^4.2.2",
        "react-router-dom": "^7.13.2",
        "react-use-measure": "^2.1.7",
        "recharts": "^2.15.4",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0",
        "uuid": "^9.0.0",
        "vaul": "^1.1.2",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "autoprefixer": "^10.4.23",
        "concurrently": "^10.0.5",
        "cross-env": "^10.1.0",
        "electron": "^41.2.0",
        "electron-builder": "^26.8.1",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "kimi-plugin-inspect-react": "^1.0.3",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.19",
        "tailwindcss-animate": "^1.0.7",
        "tsx": "^4.23.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.46.4",
        "vite": "^7.2.4"
    }
}
