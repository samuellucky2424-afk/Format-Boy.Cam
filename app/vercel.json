{
  "headers": [
    { "source": "/api/morphly-token", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] }
  ],
  "rewrites": [
    {
      "source": "/api/morphly-token",
      "destination": "/api/start-session?action=morphly-token"
    },
    {
      "source": "/api/payment/crypto-submit",
      "destination": "/api/wallet?action=crypto-submit"
    },
    {
      "source": "/api/payment-methods",
      "destination": "/api/wallet?action=payment-methods"
    }
  ]
}
